// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // L'API est compilée en CommonJS : le client doit l'être aussi
  // (en dev, tsx accepte les deux ; en prod, node est strict).
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StatutCompteClient {
  ACTIF
  SUSPENDU
}

// Modules optionnels accordés par l'éditeur à un compte client
// (base des futures offres commerciales — extensible).
enum ModuleCompte {
  FOOD_COST
  QR_MENU
}

enum StatutEtablissement {
  ACTIF
  INACTIF
}

enum RoleUtilisateur {
  SUPER_ADMIN
  GERANT
  SERVEUR
}

enum StatutUtilisateur {
  ACTIF
  DESACTIVE
}

// Droits spécifiques activables individuellement (en plus du rôle).
enum DroitUtilisateur {
  ANNULER
  CLOTURER
  REMISER
  GERER_STOCK
}

// Geste commercial : remise sur l'addition, ou article offert.
enum TypeRemise {
  REMISE
  OFFERT
}

enum StatutCategorie {
  ACTIF
  INACTIF
}

// Sépare le food cost du beverage cost dans les rapports.
enum TypeCategorie {
  NOURRITURE
  BOISSON
}

enum StatutProduit {
  ACTIF
  INACTIF
}

enum CanalCommande {
  SUR_PLACE
  EMPORTER
}

enum StatutCommande {
  ENVOYEE
  ANNULEE
}

enum FormeTable {
  RONDE
  CARREE
  RECTANGULAIRE
}

enum StatutTable {
  ACTIF
  INACTIF
}

enum StatutAddition {
  OUVERTE
  PAYEE
}

enum ModePaiement {
  ESPECES
  CARTE
  CHEQUE
  AUTRE
}

enum StatutJourneeCaisse {
  OUVERTE
  CLOTUREE
}

model CompteClient {
  id          String             @id @default(cuid())
  nomEnseigne String
  statut      StatutCompteClient @default(ACTIF)
  modules     ModuleCompte[]     @default([FOOD_COST, QR_MENU])
  // Compte de vitrine, reconstruit par scripts/seed-demo.ts. Seuls ces comptes
  // sont purgeables : les données d'un vrai client ne doivent jamais dépendre
  // d'un rafraîchissement de la démo.
  demo        Boolean            @default(false)
  creeLe      DateTime           @default(now())

  etablissements Etablissement[]
  utilisateurs   Utilisateur[]

  @@map("comptes_clients")
}

model Etablissement {
  id                   String              @id @default(cuid())
  nom                  String
  adresse              String?
  ville                String?
  // Code tapé une fois sur une tablette pour la rattacher à cet établissement.
  // Sans lui, la liste des établissements ne peut plus être devinée : elle
  // n'est plus exposée publiquement. Le gérant peut le régénérer si une
  // tablette est perdue.
  codeTerminal         String              @unique
  statut               StatutEtablissement @default(ACTIF)
  moyensPaiementActifs ModePaiement[]      @default([ESPECES, CARTE, CHEQUE, AUTRE])
  // Préférence du gérant : masquer le suivi des coûts même si le module
  // FOOD_COST est accordé au compte.
  suiviCoutsActive     Boolean             @default(true)
  // Le gérant choisit d'accepter (ou non) les commandes passées par les
  // clients depuis le QR à table. Désactivé par défaut : opt-in explicite.
  commandeClientActive Boolean             @default(false)

  // Réservation en ligne par le client depuis le menu QR. Opt-in lui aussi, et
  // borné par le gérant : une réservation en ligne engage une table sans que
  // personne n'ait décroché, donc il fixe jusqu'où il accepte d'aller. Au-delà,
  // le client est renvoyé vers le téléphone plutôt que refusé sans explication.
  reservationEnLigneActive   Boolean @default(false)
  // Couverts maximum pour une réservation en ligne : au-delà, un grand groupe
  // se négocie de vive voix (menu, acompte, disposition de la salle).
  reservationCouvertsMax     Int     @default(8)
  // Délai minimum entre la demande et l'heure du repas : le temps que la
  // cuisine et la salle voient venir.
  reservationDelaiMinMinutes Int     @default(120)
  // Horizon maximum : au-delà, le restaurant préfère être appelé.
  reservationHorizonJours    Int     @default(30)

  creeLe               DateTime            @default(now())

  compteClientId String
  compteClient   CompteClient @relation(fields: [compteClientId], references: [id])

  utilisateurs    Utilisateur[]
  categories      Categorie[]
  produits        Produit[]
  commandes       Commande[]
  tables          Table[]
  additions       Addition[]
  annulations     Annulation[]
  journeesCaisse  JourneeCaisse[]
  remises         Remise[]
  reservations    Reservation[]
  demandesClients DemandeClient[]

  @@map("etablissements")
}

model Utilisateur {
  id             String             @id @default(cuid())
  role           RoleUtilisateur
  nom            String
  prenom         String
  email          String?            @unique
  motDePasseHash String?
  codePinHash    String?
  droits         DroitUtilisateur[] @default([])
  statut         StatutUtilisateur  @default(ACTIF)
  creeLe         DateTime           @default(now())
  majLe          DateTime           @updatedAt

  // Coupe les sessions ouvertes avant cette date. Les jetons d'authentification
  // sont signés, pas stockés : sans ce repère, quelqu'un qui aurait volé un mot
  // de passe resterait connecté jusqu'à huit heures APRÈS que le gérant l'ait
  // changé — ce qui viderait la réinitialisation de son sens.
  sessionsInvalidesAvant DateTime?

  compteClientId String?
  compteClient   CompteClient? @relation(fields: [compteClientId], references: [id])

  etablissementId String?
  etablissement   Etablissement? @relation(fields: [etablissementId], references: [id])

  commandes            Commande[]
  annulationsValidees  Annulation[]    @relation("AnnulationsValidees")
  annulationsDemandees Annulation[]    @relation("AnnulationsDemandees")
  journeesOuvertes     JourneeCaisse[] @relation("JourneesOuvertes")
  journeesCloturees    JourneeCaisse[] @relation("JourneesCloturees")
  cloturesDemandees    JourneeCaisse[] @relation("CloturesDemandees")
  remisesAccordees     Remise[]        @relation("RemisesAccordees")
  remisesDemandees     Remise[]        @relation("RemisesDemandees")
  reservationsPrises   Reservation[]
  demandesTraitees     DemandeClient[]
  jetonsReinitialisation JetonReinitialisation[]

  @@map("utilisateurs")
}

// Demande de réinitialisation de mot de passe, à usage unique et de courte durée.
//
// Le jeton est stocké EN CLAIR, contrairement à un mot de passe : tant que
// Maïda n'envoie pas d'e-mails, c'est l'éditeur qui lit le lien dans son espace
// et le transmet au gérant par téléphone. Le compromis est assumé et borné —
// une heure de validité, un seul usage, un seul jeton vivant par personne, et
// il n'est lisible que par le super-admin authentifié. Le jour où l'envoi
// automatique existera, ce champ pourra passer à un hash sans rien changer
// d'autre : la validation compare déjà le jeton reçu à celui-ci.
model JetonReinitialisation {
  id            String      @id @default(cuid())
  jeton         String      @unique
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now())
  expireLe      DateTime
  utiliseLe     DateTime?
  // D'où venait la demande : utile si quelqu'un s'amuse à en déclencher.
  ip            String?

  @@index([utilisateurId])
  @@map("jetons_reinitialisation")
}

model Categorie {
  id             String          @id @default(cuid())
  nom            String
  type           TypeCategorie   @default(NOURRITURE)
  // Suite de service par défaut des produits de la catégorie :
  // 1 = entrée (préparée dès l'envoi), 2 = plat, 3 = dessert.
  suiteParDefaut Int             @default(1)
  statut         StatutCategorie @default(ACTIF)
  creeLe         DateTime        @default(now())

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  produits Produit[]

  @@map("categories")
}

model Produit {
  id                      String        @id @default(cuid())
  nom                     String
  description             String?
  prix                    Decimal       @db.Decimal(10, 2)
  // Taux de TVA en % (prix TTC : la TVA est extraite du prix affiché).
  // Algérie : 19 % taux normal, 9 % taux réduit.
  tauxTva                 Int           @default(19)
  // Coût de production saisi par le gérant (matières premières). Sert au food cost.
  coutRevient             Decimal?      @db.Decimal(10, 2)
  tempsPreparationMinutes Int?
  statut                  StatutProduit @default(ACTIF)
  // Gestion des stocks / ruptures.
  // disponible=false → rupture manuelle (« 86 »). suiviQuantite active le
  // décompte par service : quantiteRestante diminue à chaque envoi en cuisine et,
  // à 0, le produit devient non commandable (rupture automatique).
  disponible              Boolean       @default(true)
  suiviQuantite           Boolean       @default(false)
  quantiteRestante        Int?
  creeLe                  DateTime      @default(now())

  categorieId String
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  lignesCommande LigneCommande[]
  groupesOptions GroupeOption[]

  @@map("produits")
}

model GroupeOption {
  id          String   @id @default(cuid())
  nom         String
  obligatoire Boolean  @default(false)
  creeLe      DateTime @default(now())

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  valeurs OptionValeur[]

  @@map("groupes_options")
}

model OptionValeur {
  id     String   @id @default(cuid())
  valeur String
  creeLe DateTime @default(now())

  groupeOptionId String
  groupeOption   GroupeOption @relation(fields: [groupeOptionId], references: [id], onDelete: Cascade)

  lignesOptions LigneCommandeOption[]

  @@map("options_valeurs")
}

model Commande {
  id             String         @id @default(cuid())
  canal          CanalCommande
  noteCuisine    String?
  statut         StatutCommande @default(ENVOYEE)
  // Générée par la caisse pour les commandes prises hors ligne : garantit
  // qu'une resynchronisation répétée ne crée jamais de doublon.
  cleIdempotence String?        @unique
  // La cuisine prépare les suites <= suiteReclamee ; le serveur « réclame »
  // la suivante quand la table est prête.
  suiteReclamee  Int            @default(1)
  creeLe         DateTime       @default(now())

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  serveurId String
  serveur   Utilisateur @relation(fields: [serveurId], references: [id])

  additionId String
  addition   Addition @relation(fields: [additionId], references: [id])

  lignes        LigneCommande[]
  annulations   Annulation[]
  demandeClient DemandeClient?

  @@map("commandes")
}

model LigneCommande {
  id                  String   @id @default(cuid())
  nomProduit          String
  prixUnitaire        Decimal  @db.Decimal(10, 2)
  // Coût de revient du produit figé au moment de la commande (comme prixUnitaire).
  coutRevientUnitaire Decimal? @db.Decimal(10, 2)
  // Taux de TVA figé au moment de la commande (null sur l'historique d'avant la TVA).
  tauxTva             Int?
  // Suite de service (1 = entrée, 2 = plat, 3 = dessert), corrigeable à la caisse.
  suite               Int      @default(1)
  quantite            Int
  quantitePayee       Int      @default(0)
  quantiteAnnulee     Int      @default(0)
  quantiteOfferte     Int      @default(0)
  creeLe              DateTime @default(now())

  commandeId String
  commande   Commande @relation(fields: [commandeId], references: [id])

  produitId String
  produit   Produit @relation(fields: [produitId], references: [id])

  options        LigneCommandeOption[]
  paiementLignes PaiementLigne[]
  annulations    Annulation[]
  remises        Remise[]

  @@map("lignes_commande")
}

model Addition {
  id        String         @id @default(cuid())
  statut    StatutAddition @default(OUVERTE)
  ouverteLe DateTime       @default(now())
  fermeeLe  DateTime?

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  tableId String?
  table   Table?  @relation(fields: [tableId], references: [id])

  commandes Commande[]
  paiements Paiement[]
  remises   Remise[]

  @@map("additions")
}

// Trace de chaque geste commercial : qui, quand, combien, pourquoi.
model Remise {
  id          String     @id @default(cuid())
  type        TypeRemise
  montant     Decimal    @db.Decimal(10, 2)
  // Renseigné si la remise a été saisie en pourcentage.
  pourcentage Int?
  // Renseigné pour un article offert.
  quantite    Int?
  motif       String
  commentaire String?
  creeLe      DateTime   @default(now())

  // Générée par la caisse pour les gestes accordés hors ligne : garantit
  // qu'une resynchronisation répétée n'applique jamais deux fois le geste.
  // Un offert peut porter sur plusieurs articles, donc créer plusieurs lignes
  // ici : seule la première porte la clé, et sa présence suffit à reconnaître
  // la requête déjà appliquée (les lignes naissent dans la même transaction).
  cleIdempotence String? @unique

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  additionId String
  addition   Addition @relation(fields: [additionId], references: [id])

  ligneCommandeId String?
  ligneCommande   LigneCommande? @relation(fields: [ligneCommandeId], references: [id])

  // Celui qui porte la responsabilité (serveur avec le droit, ou gérant validant).
  accordeeParId String
  accordeePar   Utilisateur @relation("RemisesAccordees", fields: [accordeeParId], references: [id])

  // Le serveur qui a demandé, quand la validation vient d'un gérant.
  demandeeParId String?
  demandeePar   Utilisateur? @relation("RemisesDemandees", fields: [demandeeParId], references: [id])

  @@map("remises")
}

model Paiement {
  id             String       @id @default(cuid())
  montant        Decimal      @db.Decimal(10, 2)
  moyenPaiement  ModePaiement
  montantRecu    Decimal?     @db.Decimal(10, 2)
  // Générée par la caisse pour les encaissements hors ligne : garantit
  // qu'une resynchronisation répétée ne crée jamais de double paiement.
  cleIdempotence String?      @unique
  creeLe         DateTime     @default(now())

  additionId String
  addition   Addition @relation(fields: [additionId], references: [id])

  journeeCaisseId String?
  journeeCaisse   JourneeCaisse? @relation(fields: [journeeCaisseId], references: [id])

  lignes PaiementLigne[]

  @@map("paiements")
}

// Journée de caisse : ouverte le matin avec un fond de caisse, clôturée le soir
// avec comptage des espèces. Les paiements s'y rattachent au fil de la journée.
model JourneeCaisse {
  id           String              @id @default(cuid())
  statut       StatutJourneeCaisse @default(OUVERTE)
  fondDeCaisse Decimal             @db.Decimal(10, 2)
  ouverteLe    DateTime            @default(now())
  clotureeLe   DateTime?

  // Figés à la clôture : attendu = fond + espèces encaissées, écart = compté − attendu.
  especesAttendues Decimal? @db.Decimal(10, 2)
  especesComptees  Decimal? @db.Decimal(10, 2)
  ecart            Decimal? @db.Decimal(10, 2)
  commentaire      String?

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  ouverteParId String
  ouvertePar   Utilisateur @relation("JourneesOuvertes", fields: [ouverteParId], references: [id])

  // Celui qui porte la responsabilité de la clôture (serveur avec le droit, ou gérant validant).
  clotureeParId String?
  clotureePar   Utilisateur? @relation("JourneesCloturees", fields: [clotureeParId], references: [id])

  // Le serveur qui a demandé, quand la validation vient d'un gérant.
  clotureDemandeeParId String?
  clotureDemandeePar   Utilisateur? @relation("CloturesDemandees", fields: [clotureDemandeeParId], references: [id])

  paiements Paiement[]

  @@map("journees_caisse")
}

model PaiementLigne {
  id       String  @id @default(cuid())
  quantite Int
  montant  Decimal @db.Decimal(10, 2)

  paiementId String
  paiement   Paiement @relation(fields: [paiementId], references: [id])

  ligneCommandeId String
  ligneCommande   LigneCommande @relation(fields: [ligneCommandeId], references: [id])

  @@map("paiements_lignes")
}

model LigneCommandeOption {
  id        String   @id @default(cuid())
  nomGroupe String
  valeur    String
  creeLe    DateTime @default(now())

  ligneCommandeId String
  ligneCommande   LigneCommande @relation(fields: [ligneCommandeId], references: [id])

  optionValeurId String?
  optionValeur   OptionValeur? @relation(fields: [optionValeurId], references: [id], onDelete: SetNull)

  @@map("lignes_commande_options")
}

// Trace de chaque annulation : qui, quand, quoi, pourquoi.
model Annulation {
  id               String   @id @default(cuid())
  motif            String
  commentaire      String?
  quantite         Int
  montant          Decimal  @db.Decimal(10, 2)
  apresPreparation Boolean  @default(false)
  creeLe           DateTime @default(now())

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  commandeId String
  commande   Commande @relation(fields: [commandeId], references: [id])

  ligneCommandeId String?
  ligneCommande   LigneCommande? @relation(fields: [ligneCommandeId], references: [id])

  // Celui qui porte la responsabilité (serveur avec le droit, ou gérant validant).
  annuleeParId String
  annuleePar   Utilisateur @relation("AnnulationsValidees", fields: [annuleeParId], references: [id])

  // Le serveur qui a demandé, quand la validation vient d'un gérant.
  demandeeParId String?
  demandeePar   Utilisateur? @relation("AnnulationsDemandees", fields: [demandeeParId], references: [id])

  @@map("annulations")
}

// Journal des erreurs serveur : consultable par l'éditeur dans l'espace
// super-admin, pour détecter les problèmes avant que les clients n'appellent.
model ErreurServeur {
  id      String   @id @default(cuid())
  methode String
  chemin  String
  message String
  detail  String?
  creeLe  DateTime @default(now())

  @@map("erreurs_serveur")
}

enum StatutDemandeClient {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

// Commande passée par un client depuis le QR à table : elle reste une
// « demande » tant qu'un serveur ne l'a pas acceptée (anti-abus). À
// l'acceptation, une vraie Commande est créée dans le circuit normal.
model DemandeClient {
  id     String              @id @default(cuid())
  statut StatutDemandeClient @default(EN_ATTENTE)
  // Charge utile telle qu'envoyée par le client : [{ produitId, quantite, options? }]
  lignes Json
  note   String?
  creeLe DateTime            @default(now())

  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  // La commande créée si la demande a été acceptée.
  commandeId String?   @unique
  commande   Commande? @relation(fields: [commandeId], references: [id])

  traiteeParId String?
  traiteePar   Utilisateur? @relation(fields: [traiteeParId], references: [id])
  traiteeLe    DateTime?

  @@map("demandes_clients")
}

enum StatutReservation {
  A_VENIR
  ARRIVEE
  ANNULEE
  NO_SHOW
}

// Réservation prise par téléphone à la caisse, ou en ligne par le client
// lui-même depuis le menu QR — auquel cas `priseParId` est nul : personne de
// l'équipe n'a décroché, c'est le client qui a rempli le formulaire.
model Reservation {
  id             String            @id @default(cuid())
  nomClient      String
  telephone      String?
  email          String?
  nombreCouverts Int
  date           DateTime
  // Durée d'occupation prévue : sert à détecter les chevauchements.
  dureeMinutes   Int               @default(120)
  note           String?
  statut         StatutReservation @default(A_VENIR)
  creeLe         DateTime          @default(now())
  // Générée par la caisse pour les réservations prises hors ligne : garantit
  // qu'une resynchronisation répétée ne crée jamais de doublon.
  cleIdempotence String?           @unique

  tableId String
  table   Table  @relation(fields: [tableId], references: [id])

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  // Nul pour une réservation prise en ligne par le client depuis le QR : c'est
  // ce nul, et lui seul, qui distingue les deux origines. D'où le `Restrict` —
  // si une suppression d'employé pouvait vider ce champ, tout son historique
  // se relirait un jour comme « pris en ligne ».
  priseParId String?
  prisePar   Utilisateur? @relation(fields: [priseParId], references: [id], onDelete: Restrict)

  @@map("reservations")
}

model Table {
  id             String      @id @default(cuid())
  numero         String
  forme          FormeTable  @default(CARREE)
  nombreCouverts Int
  largeur        Int         @default(80)
  hauteur        Int         @default(80)
  positionX      Int         @default(20)
  positionY      Int         @default(20)
  statut         StatutTable @default(ACTIF)
  creeLe         DateTime    @default(now())

  etablissementId String
  etablissement   Etablissement @relation(fields: [etablissementId], references: [id])

  additions       Addition[]
  reservations    Reservation[]
  demandesClients DemandeClient[]

  @@unique([etablissementId, numero])
  @@map("tables")
}

enum TypeConnexion {
  MOT_DE_PASSE
  PIN
  // Changement de mot de passe via un lien de réinitialisation. Ce n'est pas
  // une connexion, mais ça se lit dans la même frise quand on enquête sur un
  // compte : « qui a changé quoi, et depuis où ».
  REINITIALISATION
}

enum ResultatConnexion {
  REUSSIE
  IDENTIFIANTS_INVALIDES
  COMPTE_SUSPENDU
  TROP_DE_TENTATIVES
}

// Journal des tentatives de connexion : sert autant au support (« qui a ouvert
// la caisse hier soir ? ») qu'à repérer un acharnement sur un code PIN.
//
// Aucune relation vers Utilisateur ou Etablissement : le journal doit survivre
// à la suppression de ce qu'il décrit. Les libellés sont donc figés à l'écriture.
model ConnexionJournal {
  id       String            @id @default(cuid())
  creeLe   DateTime          @default(now())
  type     TypeConnexion
  resultat ResultatConnexion

  utilisateurId   String?
  // Qui a tenté : « Prénom Nom » si on l'a identifié, sinon l'email saisi.
  // Jamais le mot de passe ni le code PIN.
  acteur          String?
  etablissementId String?
  etablissement   String?

  ip         String?
  navigateur String?

  @@index([creeLe])
  @@map("connexions_journal")
}

enum TypeEmail {
  MOT_DE_PASSE_OUBLIE
  CONFIRMATION_RESERVATION
}

enum ResultatEmail {
  ENVOYE
  ECHEC
  // Aucun serveur d'envoi configuré : le message a été préparé mais n'est
  // parti nulle part. C'est l'état normal tant que le domaine n'est pas en
  // service — l'éditeur voit ce qui aurait dû partir.
  NON_CONFIGURE
}

// Journal des e-mails : le premier réflexe du support quand un client dit
// « je n'ai rien reçu ». Comme le journal des connexions, il n'a aucune
// relation : il doit survivre à ce qu'il décrit, et ne garde jamais le contenu
// sensible d'un message (un lien de réinitialisation n'est pas archivé ici).
model EmailEnvoye {
  id           String        @id @default(cuid())
  creeLe       DateTime      @default(now())
  type         TypeEmail
  resultat     ResultatEmail
  destinataire String
  sujet        String
  // Message du serveur d'envoi quand il refuse, pour le dépannage.
  erreur       String?

  etablissementId String?
  etablissement   String?

  @@index([creeLe])
  @@map("emails_envoyes")
}
