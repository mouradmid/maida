# Portier HTTPS de Maïda.
#
# Caddy obtient le certificat Let's Encrypt au premier démarrage et le
# renouvelle seul ; il n'y a rien à surveiller ni à renouveler à la main.
# Le domaine vient de la variable DOMAINE du fichier .env.

{$DOMAINE} {
	encode zstd gzip

	# L'application est la seule à voir passer les requêtes ; elle a déjà
	# `trust proxy` activé, elle lit donc la vraie IP du client dans
	# X-Forwarded-For (indispensable au freinage des tentatives de connexion).
	reverse_proxy app:3001

	header {
		# Le navigateur refuse durablement de repasser en HTTP clair.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Aucun autre site ne peut afficher Maïda dans un cadre invisible pour
		# faire cliquer un gérant à son insu (« clickjacking »).
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		# La caisse n'a besoin ni de la caméra, ni du micro, ni de la position.
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Inutile d'annoncer quel logiciel répond.
		-Server
	}

	log {
		output file /data/acces.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Le même site avec « www » devant : on ne sert pas deux adresses, on renvoie
# vers la bonne. (L'enregistrement DNS « www » doit exister, sinon Caddy ne
# peut pas obtenir ce certificat — le site principal, lui, continue de vivre.)
www.{$DOMAINE} {
	redir https://{$DOMAINE}{uri} permanent
}
